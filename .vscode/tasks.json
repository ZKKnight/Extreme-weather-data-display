{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "weather-db: web dashboard",
            "type": "shell",
            "command": "python scripts/run_web.py",
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "weather-db: demo pipeline",
            "type": "shell",
            "command": "python -m weather_events.cli init; python -m weather_events.cli import-events examples/events_seed.csv; python -m weather_events.cli import-locations examples/locations_seed.csv; python -m weather_events.cli fetch --event-id E20250410_SANDSTORM; python -m weather_events.cli analyze --event-id E20250410_SANDSTORM; python -m weather_events.cli export-indices --out outputs/indices.csv",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "weather-db: list events",
            "type": "shell",
            "command": "python -m weather_events.cli list-events",
            "problemMatcher": []
        },
        {
            "label": "weather-db: fetch selected event",
            "type": "shell",
            "command": "python -m weather_events.cli fetch --event-id ${input:eventId}",
            "problemMatcher": []
        },
        {
            "label": "weather-db: analyze selected event",
            "type": "shell",
            "command": "python -m weather_events.cli analyze --event-id ${input:eventId}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "eventId",
            "type": "promptString",
            "description": "Event ID",
            "default": "E20250410_SANDSTORM"
        }
    ]
}
